# Copy to .env and fill in. Validated at startup by src/config/env.validation.ts.

NODE_ENV=development
PORT=4000

# Matches the `db` service in docker-compose.yml
DATABASE_URL="postgresql://root:root123@localhost:5432/nest?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be >= 32 characters when NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Comma-separated allowed origins. Leave empty to allow all in dev (denied in production).
CORS_ORIGINS=

# Set to true behind a reverse proxy/load balancer so rate limiting sees real client IPs.
TRUST_PROXY=false

# Swagger UI at /docs. Defaults to on outside production.
# SWAGGER_ENABLED=true

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL milliseconds.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional — only needed if you use SupabaseAuthGuard / SupabaseService.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
